#!/usr/bin/env bash
# Send a Telegram message announcing Claude Code is online.
# Called directly by the SessionStart hook — no agent involvement needed.
set -euo pipefail

CHANNEL_DIR="$HOME/.claude/channels/telegram"
ENV_FILE="$CHANNEL_DIR/.env"
ACCESS_FILE="$CHANNEL_DIR/access.json"

# Skip silently if config is missing
[[ -f "$ENV_FILE" ]] || exit 0
[[ -f "$ACCESS_FILE" ]] || exit 0

# shellcheck source=/dev/null
export $(grep -v '^#' "$ENV_FILE" | grep '=' | xargs)
[[ -n "${TELEGRAM_BOT_TOKEN:-}" ]] || exit 0

CHAT_ID=$(jq -r '.allowFrom[0] // empty' "$ACCESS_FILE")
[[ -n "$CHAT_ID" ]] || exit 0

CWD="${CLAUDE_WORKING_DIRECTORY:-$(pwd)}"
# Shorten home prefix
CWD="${CWD/#$HOME/\~}"

curl -sf -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
  -d chat_id="$CHAT_ID" \
  -d text="Claude Code is up and running in ${CWD}." \
  >/dev/null 2>&1 || true
